# ==========================================
# SCTConnect Comprehensive .gitignore
# ==========================================

# 1. Dependencies & Package Manager Locks
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# 2. Build & Compilation Artifacts
dist/
**/dist/
build/
**/build/
out/
*.tsbuildinfo

# 3. Environment Variables & Credentials / Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.crt
*.jks
*.p8
*.p12
*.mobileprovision

# 4. Expo & React Native Build Caches
.expo/
**/.expo/
web-build/
expo-env.d.ts
.metro-health-check*
*.orig.*

# Generated Native Folders (Prebuild/Bare workflow)
/android
/ios
**/android
**/ios
*.apk
*.aab
*.ipa

# 5. Editor & IDE Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 6. Temporary & Log Files
*.log
.cache/
tmp/
temp/
.gemini/
.agents/

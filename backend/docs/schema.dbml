// SCTConnect Database Schema (21 Tables)
// Database: PostgreSQL 16+

Project SCTConnect {
  database_type: 'PostgreSQL'
  Note: 'Hệ thống Nền tảng Số Mặt trận Tổ quốc Cấp Xã kết nối Nhân dân (SCTConnect)'
}

Table users {
  id uuid [pk, default: `uuid_generate_v4()`]
  phone varchar(20) [unique, not null, note: 'Số điện thoại định danh']
  full_name varchar(255) [not null, note: 'Họ và tên']
  password_hash text [not null, note: 'Mật khẩu băm Argon2id']
  user_type varchar(30) [not null, default: 'citizen', note: 'citizen | officer | admin']
  avatar_url text
  is_active boolean [not null, default: true, note: 'Trạng thái hoạt động']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table organizations {
  id uuid [pk, default: `uuid_generate_v4()`]
  parent_id uuid [ref: > organizations.id, null]
  code varchar(50) [unique, not null]
  name varchar(255) [not null]
  type varchar(50) [not null, default: 'other', note: 'mttq | party | youth_union | women_union | veterans | farmers | village | other']
  address text
  hotline varchar(50)
  settings jsonb [not null, default: '{}']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table roles {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(50) [unique, not null]
  name varchar(100) [not null]
  description text
  is_system boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table permissions {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(100) [unique, not null]
  name varchar(255) [not null]
  module varchar(50) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table role_permissions {
  id uuid [pk, default: `uuid_generate_v4()`]
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [unique]
  }
}

Table user_organizations {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.id]
  organization_id uuid [not null, ref: > organizations.id]
  role_id uuid [not null, ref: > roles.id]
  title_name varchar(100) [not null]
  is_primary boolean [not null, default: false]
  joined_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, organization_id, role_id) [unique]
  }
}

Table feedbacks {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(50) [unique, not null]
  user_id uuid [not null, ref: > users.id]
  assigned_org_id uuid [ref: > organizations.id, null]
  assigned_user_id uuid [ref: > users.id, null]
  title varchar(255) [not null]
  content text [not null]
  address text
  latitude numeric(10, 8)
  longitude numeric(11, 8)
  status varchar(30) [not null, default: 'pending', note: 'pending | processing | resolved | rejected']
  priority varchar(20) [not null, default: 'medium', note: 'low | medium | high | urgent']
  category varchar(50) [not null, default: 'other']
  is_public boolean [not null, default: true]
  resolution_note text
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table feedback_attachments {
  id uuid [pk, default: `uuid_generate_v4()`]
  feedback_id uuid [not null, ref: > feedbacks.id]
  file_url text [not null]
  file_type varchar(50) [not null]
  file_size integer
  type varchar(20) [not null, default: 'initial', note: 'initial | resolution']
  created_at timestamptz [not null, default: `now()`]
}

Table feedback_histories {
  id uuid [pk, default: `uuid_generate_v4()`]
  feedback_id uuid [not null, ref: > feedbacks.id]
  action_by_user_id uuid [not null, ref: > users.id]
  action varchar(50) [not null]
  from_status varchar(30)
  to_status varchar(30)
  note text
  created_at timestamptz [not null, default: `now()`]
}

Table feedback_comments {
  id uuid [pk, default: `uuid_generate_v4()`]
  feedback_id uuid [not null, ref: > feedbacks.id]
  user_id uuid [not null, ref: > users.id]
  content text [not null]
  is_internal boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

Table feedback_ratings {
  id uuid [pk, default: `uuid_generate_v4()`]
  feedback_id uuid [unique, not null, ref: > feedbacks.id]
  user_id uuid [not null, ref: > users.id]
  rating integer [not null, note: '1 - 5 sao']
  comment text
  created_at timestamptz [not null, default: `now()`]
}

Table citizen_receptions {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(50) [unique, not null]
  citizen_id uuid [not null, ref: > users.id]
  leader_user_id uuid [ref: > users.id, null]
  organization_id uuid [ref: > organizations.id, null]
  scheduled_at timestamptz [not null]
  room varchar(100)
  topic varchar(255) [not null]
  content text [not null]
  conclusion text
  status varchar(30) [not null, default: 'scheduled', note: 'scheduled | in_progress | completed | cancelled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table reception_participants {
  id uuid [pk, default: `uuid_generate_v4()`]
  reception_id uuid [not null, ref: > citizen_receptions.id]
  officer_user_id uuid [not null, ref: > users.id]
  role_in_reception varchar(100)
  created_at timestamptz [not null, default: `now()`]
}

Table reception_attachments {
  id uuid [pk, default: `uuid_generate_v4()`]
  reception_id uuid [not null, ref: > citizen_receptions.id]
  file_url text [not null]
  file_name varchar(255) [not null]
  file_size integer
  created_at timestamptz [not null, default: `now()`]
}

Table polls {
  id uuid [pk, default: `uuid_generate_v4()`]
  created_by_user_id uuid [not null, ref: > users.id]
  title varchar(255) [not null]
  description text
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  is_closed boolean [not null, default: false]
  target_org_id uuid [ref: > organizations.id, null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table poll_options {
  id uuid [pk, default: `uuid_generate_v4()`]
  poll_id uuid [not null, ref: > polls.id]
  option_text varchar(255) [not null]
  order_index integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table poll_votes {
  id uuid [pk, default: `uuid_generate_v4()`]
  poll_id uuid [not null, ref: > polls.id]
  poll_option_id uuid [not null, ref: > poll_options.id]
  user_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (poll_id, user_id) [unique]
  }
}

Table posts {
  id uuid [pk, default: `uuid_generate_v4()`]
  author_id uuid [not null, ref: > users.id]
  organization_id uuid [ref: > organizations.id, null]
  title varchar(255) [not null]
  slug varchar(255) [unique, not null]
  summary text
  content text [not null]
  cover_url text
  category varchar(50) [not null, default: 'news']
  is_published boolean [not null, default: false]
  is_pinned boolean [not null, default: false]
  is_emergency boolean [not null, default: false]
  view_count integer [not null, default: 0]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table notifications {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.id]
  title varchar(255) [not null]
  body text [not null]
  type varchar(50) [not null]
  data jsonb [not null, default: '{}']
  is_read boolean [not null, default: false]
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table user_devices {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.id]
  device_token text [not null]
  platform varchar(20) [not null, note: 'ios | android | web']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table uploads {
  id uuid [pk, default: `uuid_generate_v4()`]
  uploaded_by_user_id uuid [not null, ref: > users.id]
  file_name varchar(255) [not null]
  file_url text [not null]
  mime_type varchar(100) [not null]
  file_size integer [not null]
  storage_provider varchar(30) [not null, default: 's3']
  created_at timestamptz [not null, default: `now()`]
}
